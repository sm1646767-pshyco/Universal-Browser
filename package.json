{
  "name": "universal-browser",
  "version": "6.0.1",
  "description": "Universal Browser — Ad-free, AI-native, privacy-first browser by Shubham Maurya",
  "main": "main.js",
  "author": "Shubham Maurya",
  "license": "MIT",
  "homepage": "https://github.com/sm1646767-pshyco/Universal-Browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/sm1646767-pshyco/Universal-Browser.git"
  },
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . 2>&1",
    "build": "electron-builder --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:all": "electron-builder -mwl --publish never"
  },
  "dependencies": {
    "openai": "^4.20.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.shubhammaurya.universalbrowser",
    "productName": "Universal Browser",
    "copyright": "Copyright © 2026 Shubham Maurya",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "ai.js",
      "workspace.js",
      "tabs.js",
      "notes.js",
      "backup.js",
      "onboarding.js",
      "performance.js",
      "privacy.js",
      "extensions.js",
      "package.json"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "identity": null,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Universal Browser",
      "icon": "build/icon.icns",
      "iconSize": 100,
      "contents": [
        { "x": 130, "y": 220, "type": "file" },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "publisherName": "Shubham Maurya"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Universal Browser",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "synopsis": "Ad-free universal browser",
      "description": "Universal Browser — Ad-free, AI-native, privacy-first browser by Shubham Maurya"
    }
  }
}